<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FC">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/noteToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_media_previous"
        app:title="New Note"
        app:titleTextColor="#172554"
        app:elevation="0dp" />

    <!-- Editor Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Checkbox -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxAiSupport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Writing Support"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:checked="false" />

            <!-- Description Text (চেকবক্সের সাথে সামঞ্জস্য রেখে একটু মার্জিন দেওয়া হয়েছে) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="Just explain your idea and let AI help you write it."
                android:textColor="#929BAD"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Note Title -->
        <EditText
            android:id="@+id/etNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@null"
            android:hint="Note title"
            android:textColor="#172554"
            android:textColorHint="#AAB1C0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:padding="0dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E5E9F2" />

        <!-- Note Description -->
        <EditText
            android:id="@+id/etNoteContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:background="@null"
            android:hint="Start writing your thoughts..."
            android:textColor="#38445A"
            android:textColorHint="#AAB1C0"
            android:textSize="16sp"
            android:gravity="top|start"
            android:fontFamily="sans-serif"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="0dp"
            android:lineSpacingExtra="6dp"
            android:overScrollMode="ifContentScrolls" />

    </LinearLayout>

    <!-- Bottom Action Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp">

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNote"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Note"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#536DFE"
            app:cornerRadius="14dp"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart" />

        <!-- Progess Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            style="?android:attr/progressBarStyleSmall" />

    </LinearLayout>

</LinearLayout>
