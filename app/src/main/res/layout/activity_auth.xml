
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#F7F8FC"
    android:padding="28dp"
    tools:context=".AuthActivity">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="20dp">

        <!-- Brand Icon -->
        <TextView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:background="#536DFE"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mastake"
            android:textColor="#172554"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Welcome Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Your ideas deserve\na smarter space."
            android:textColor="#172554"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Capture your thoughts, organize your notes\nand connect with your smart devices."
            android:textColor="#7B8498"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp" />

    </LinearLayout>

    <!-- Authentication Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Google Sign In Button -->
        <LinearLayout
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/googleIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="23sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/googleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Continue with Google"
                android:textColor="#263248"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Optional: Add a ProgressBar to indicate loading state -->
            <ProgressBar
                android:id="@+id/googleProgressBar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="#536DFE" />

        </LinearLayout>

        <!-- Account Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="New here? Your account will be created automatically."
            android:textColor="#929BAD"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By continuing, you agree to our"
            android:textColor="#929BAD"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Terms of Service  ·  Privacy Policy"
            android:textColor="#536DFE"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
